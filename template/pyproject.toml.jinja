[project]
name = "{{ repo_name }}"
version = "0.0.0"
description = "{{ description | replace('\\', '\\\\') | replace('"', '\\"') }}"
requires-python = ">={{ python_version }}"

[dependency-groups]
dev = [
    "copier==9.18.2",
    "pytest>=8",
    "pyyaml>=6",
]

[tool.uv]
package = false

[tool.pytest.ini_options]
testpaths = ["tests"]
